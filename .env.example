# Salin file ini menjadi .env lalu isi dengan nilai Anda sendiri. JANGAN commit .env.

# Koneksi Neon Postgres (dengan pooler), dipakai aplikasi
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Koneksi Neon tanpa pooler, dipakai drizzle-kit dan skrip seed
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Kunci rahasia untuk mengenkripsi cookie sesi login (teks acak, minimal 32 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_APP_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
